  opacity:1;
  filter:drop-shadow(0 3px 9px rgba(0,0,0,.13));
}

/* =========================================================
   LIGHT MODE V5 — tighter, subtler logo-card fade
   Keeps the darker focus behind the logos only.
   ========================================================= */
html[data-theme="light"] .partners-panel{
  background:
    radial-gradient(
      ellipse 48% 58% at 50% 50%,
      rgba(40,69,84,.88) 0%,
      rgba(53,81,94,.72) 34%,
      rgba(92,116,126,.34) 60%,
