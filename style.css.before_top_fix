  opacity:1;
  filter:drop-shadow(0 3px 8px rgba(0,0,0,.12));
}

/* =========================================================
   LIGHT MODE V6 — fade only at the CARD EDGES
   Darker center keeps the logos prominent; edges blend
   softly into the off-white page.
   ========================================================= */
html[data-theme="light"] .partners-panel{
  background:
    radial-gradient(
      ellipse 76% 78% at 50% 50%,
      #294757 0%,
      #294757 58%,
      rgba(41,71,87,.90) 70%,
      rgba(41,71,87,.58) 84%,
      rgba(41,71,87,.18) 96%,
      rgba(41,71,87,0) 100%
    );
  border-color:rgba(78,108,120,.16);
  box-shadow:
    0 10px 28px rgba(42,65,79,.045),
    inset 0 0 0 1px rgba(255,255,255,.025);
}

/* Remove the previous center-overlay fade. */
html[data-theme="light"] .partners-panel::after{
  background:none;
  opacity:0;
}

html[data-theme="light"] .partner-logo{
  opacity:.96;
  filter:drop-shadow(0 2px 7px rgba(0,0,0,.10));
}

html[data-theme="light"] .partner-logo:hover{
  opacity:1;
  filter:drop-shadow(0 3px 9px rgba(0,0,0,.14));
}

/* =========================================================
   LIGHT MODE V7 — full perimeter fade
   The center stays readable while TOP / BOTTOM / LEFT /
   RIGHT edges all fade smoothly into the page.
   ========================================================= */
html[data-theme="light"] .partners-panel{
  background:
    radial-gradient(
      ellipse 62% 72% at 50% 50%,
      rgba(41,71,87,1) 0%,
      rgba(41,71,87,.98) 42%,
      rgba(41,71,87,.86) 58%,
      rgba(41,71,87,.55) 72%,
      rgba(41,71,87,.22) 86%,
      rgba(41,71,87,0) 100%
    );
  border-color:rgba(91,119,131,.10);
  box-shadow:none;
}

/* Remove the old edge overlay so the new fade controls the
   entire perimeter consistently. */
html[data-theme="light"] .partners-panel::after{
  display:none;
}

/* Keep the logo area crisp against the softer perimeter. */
html[data-theme="light"] .partner-logo{
  opacity:.96;
  filter:drop-shadow(0 2px 7px rgba(0,0,0,.10));
}

html[data-theme="light"] .partner-logo:hover{
  opacity:1;
  filter:drop-shadow(0 3px 9px rgba(0,0,0,.14));
}

/* =========================================================
   LIGHT MODE V8 — clean solid partner card
   A muted blue-grey surface replaces the fade so the
   partner section feels intentional and the logos pop.
   ========================================================= */
