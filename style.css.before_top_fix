*{box-sizing:border-box}
:root{
  --bg:#06111f;
  --bg-soft:#091a2c;
  --panel:rgba(10,30,49,.82);
  --panel-2:rgba(13,37,59,.72);
  --line:rgba(151,194,225,.13);
  --text:#edf6ff;
  --muted:#8da5bd;
  --muted-2:#607a94;
  --cyan:#45c7ff;
  --cyan-2:#1798d4;
  --green:#39e6a4;
  --yellow:#ffd166;
  --blue:#56a8ff;
  --shadow:0 22px 55px rgba(0,0,0,.22);
}
html{scroll-behavior:smooth}
body{
  margin:0;
  min-height:100vh;
  color:var(--text);
  background:
    radial-gradient(circle at 50% -15%,rgba(28,119,177,.20),transparent 36%),
    radial-gradient(circle at 100% 35%,rgba(0,187,255,.055),transparent 30%),
    var(--bg);
  font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  -webkit-font-smoothing:antialiased;
}
body:before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background-image:linear-gradient(rgba(255,255,255,.012) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.012) 1px,transparent 1px);
  background-size:46px 46px;
  mask-image:linear-gradient(to bottom,#000,transparent 80%);
}
.ambient{position:fixed;width:420px;height:420px;border-radius:50%;filter:blur(90px);opacity:.09;pointer-events:none}
.ambient-a{background:#008fcb;left:-220px;top:35%}
.ambient-b{background:#1b6cff;right:-250px;top:5%}
.topbar{
  height:78px;
  padding:0 max(24px,5vw);
  display:flex;
  align-items:center;
  justify-content:space-between;
  border-bottom:1px solid var(--line);
  background:rgba(4,15,27,.78);
  backdrop-filter:blur(18px);
  position:sticky;
  top:0;
  z-index:10;
}
.brand{display:flex;align-items:center;gap:12px;color:var(--text);text-decoration:none}
.brand-mark{
  width:38px;height:38px;border-radius:11px;
  display:grid;place-items:center;
  background:linear-gradient(145deg,rgba(69,199,255,.18),rgba(69,199,255,.04));
  border:1px solid rgba(69,199,255,.24);
}
.brand-mark svg{width:22px;height:22px;fill:none;stroke:var(--cyan);stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.brand strong{display:block;font-size:16px;letter-spacing:2px}
.brand small{display:block;color:var(--muted);font-size:10px;margin-top:2px;letter-spacing:.3px}
.top-status{
  display:flex;align-items:center;gap:9px;
  padding:8px 12px;border:1px solid var(--line);
  border-radius:12px;background:rgba(11,31,50,.72)
}
.status-dot{width:8px;height:8px;border-radius:50%;background:#8794a3;box-shadow:0 0 0 4px rgba(135,148,163,.07)}
.top-status.online .status-dot{background:var(--green);box-shadow:0 0 14px rgba(57,230,164,.7)}
.status-label{display:block;color:var(--muted-2);font-size:8px;letter-spacing:1.3px;font-weight:800}
.top-status b{display:block;font-size:11px;letter-spacing:1px;color:#c7d5e3;margin-top:1px}
.top-status.online b{color:var(--green)}
main{width:min(1380px,90%);margin:auto;padding:42px 0 30px}
.hero{
  display:flex;justify-content:space-between;align-items:flex-end;
  gap:30px;margin-bottom:28px
}
.eyebrow{display:flex;align-items:center;gap:8px;color:var(--cyan);font-size:10px;font-weight:800;letter-spacing:2px}
.eyebrow span{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 12px rgba(69,199,255,.7)}
.hero h1{font-size:clamp(38px,5vw,58px);line-height:1;margin:11px 0 10px;letter-spacing:-2px}
.hero p{margin:0;max-width:650px;color:var(--muted);font-size:14px;line-height:1.65}
.live-meta{text-align:right;min-width:180px}
.live-badge{
  display:inline-flex;align-items:center;gap:7px;
  padding:7px 10px;border:1px solid rgba(57,230,164,.18);
  border-radius:999px;background:rgba(57,230,164,.055);
  color:var(--green);font-size:9px;font-weight:800;letter-spacing:1.1px
}
.live-badge i{width:6px;height:6px;border-radius:50%;background:var(--green);box-shadow:0 0 10px rgba(57,230,164,.7)}
.update-label{margin-top:13px;color:var(--muted-2);font-size:9px;letter-spacing:1.3px;font-weight:800}
.live-meta strong{display:block;margin-top:4px;color:#dce9f5;font-size:12px}
.metric-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:18px}
.metric-card{
  position:relative;overflow:hidden;
  min-height:154px;padding:18px 19px;
  background:linear-gradient(145deg,rgba(14,38,61,.88),rgba(7,24,40,.90));
  border:1px solid var(--line);
  border-radius:17px;
  box-shadow:var(--shadow);
  transition:transform .2s ease,border-color .2s ease,background .2s ease
}
.metric-card:after{
  content:"";position:absolute;width:100px;height:100px;border-radius:50%;
  right:-50px;bottom:-60px;opacity:.08;background:var(--accent,var(--cyan));filter:blur(4px)
}
.metric-card:hover{transform:translateY(-2px);border-color:rgba(125,191,226,.24);background:linear-gradient(145deg,rgba(17,44,70,.94),rgba(8,27,45,.94))}
.metric-card.temperature{--accent:#ff9d5c}
.metric-card.humidity{--accent:#57b8ff}
.metric-card.pressure{--accent:#9d9cff}
.metric-card.water{--accent:#38d7c1}
.metric-card.solar{--accent:#ffd166}
.metric-head{display:flex;align-items:center;justify-content:space-between;gap:10px}
.metric-head>span{font-size:9px;letter-spacing:1.45px;font-weight:800;color:#7894ae}
.metric-icon{
  width:34px;height:34px;border-radius:10px;display:grid;place-items:center;
  background:rgba(255,255,255,.035);border:1px solid rgba(255,255,255,.07)
}
.metric-icon svg{width:18px;height:18px;fill:none;stroke:var(--accent,var(--cyan));stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.metric-value{display:flex;align-items:baseline;gap:6px;margin-top:21px}
.metric-value strong{font-size:30px;line-height:1;font-weight:760;letter-spacing:-.7px}
.metric-value small{font-size:11px;color:#8ba3b9;font-weight:650}
.metric-caption{margin-top:9px;color:var(--muted-2);font-size:10px}
.section-panel{
  padding:20px 20px 18px;margin-top:14px;
  background:linear-gradient(145deg,rgba(11,33,54,.90),rgba(7,23,39,.92));
  border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)
}
.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;margin-bottom:14px}
.section-kicker{font-size:9px;color:var(--cyan);font-weight:800;letter-spacing:1.6px;margin-bottom:4px}
.section-head h2{margin:0;font-size:16px;letter-spacing:-.2px}
.section-head p{margin:5px 0 0;color:var(--muted-2);font-size:11px}
select{
  min-width:110px;padding:8px 10px;border-radius:9px;
  border:1px solid rgba(255,255,255,.1);
  background:#0a2035;color:#dce8f5;outline:0;font-size:11px
}
select:focus{border-color:rgba(69,199,255,.4)}
.chart-note{display:flex;align-items:center;gap:7px;color:var(--muted-2);font-size:10px}
.chart-note span{width:7px;height:7px;border-radius:50%;background:var(--cyan);box-shadow:0 0 9px rgba(69,199,255,.5)}
.chart-wrap{height:300px;position:relative}
.chart-wrap.large{height:335px}
footer{
  display:flex;justify-content:center;align-items:center;gap:9px;
  padding:26px 0 12px;color:#4f6881;font-size:9px;letter-spacing:1.1px
}
.footer-brand{color:#7892aa;font-weight:800}
.footer-separator{opacity:.45}
@media(max-width:1050px){
  .metric-grid{grid-template-columns:repeat(2,1fr)}
}
@media(max-width:680px){
  .topbar{height:70px;padding:0 18px}
  .brand strong{font-size:14px}.brand small{font-size:9px}
  .top-status{padding:7px 9px}.status-label{display:none}
  main{width:92%;padding-top:30px}
  .hero{flex-direction:column;align-items:flex-start;gap:20px}
  .hero h1{font-size:42px}
  .live-meta{text-align:left}
  .metric-grid{grid-template-columns:repeat(2,1fr);gap:10px}
  .metric-card{min-height:140px;padding:15px}
  .metric-value strong{font-size:25px}
  .section-panel{padding:16px 14px}
  .section-head{align-items:flex-start}
  .section-head p{max-width:230px}
  .chart-wrap{height:260px}.chart-wrap.large{height:290px}
  footer{flex-wrap:wrap;padding-bottom:20px}
}
@media(max-width:430px){
  .metric-grid{grid-template-columns:1fr}
  .metric-card{min-height:130px}
  .metric-value{margin-top:17px}
  .hero h1{font-size:38px}
}


.partners-panel{
  margin-top:14px;
  padding:20px 26px 22px;
  background:linear-gradient(145deg,rgba(11,33,54,.70),rgba(7,23,39,.78));
  border:1px solid rgba(151,194,225,.10);
  border-radius:18px;
  box-shadow:0 18px 45px rgba(0,0,0,.16);
}

.partner-row{
  display:block;
  width:100%;
  text-align:center;
}

.partner-title{
  display:block;
  width:100%;
  margin:0 0 8px;
  text-align:center;
}

.partner-title span{
  color:#6685a2;
  font-size:9px;
  font-weight:800;
  letter-spacing:2px;
  line-height:1.55;
}

.partner-logos{
  display:flex;
  flex-direction:row;
  flex-wrap:nowrap;
  align-items:center;
  justify-content:center;
  gap:22px;
  width:100%;
  min-width:0;
}

.partner-logo{
  flex:0 0 170px;
  width:170px;
  height:58px;
  display:flex;
  align-items:center;
  justify-content:center;
  opacity:.62;
  transition:opacity .2s ease,transform .2s ease;
}

.partner-logo:hover{
  opacity:.88;
  transform:translateY(-1px);
}

.partner-logo img{
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
  object-position:center;
}

.logo-3dlab img{height:54px}
.logo-veltrix img{height:50px}
.logo-uthm img{height:56px}
.logo-fkee img{height:52px}
.logo-innocube img{height:48px}

.partner-divider{
  flex:0 0 1px;
  width:1px;
  height:32px;
  background:rgba(151,194,225,.13);
}

.partner-separator{
  width:62%;
  height:1px;
  margin:8px auto;
  background:linear-gradient(90deg,transparent,rgba(151,194,225,.13),transparent);
}

@media(max-width:900px){
  .partner-logos{
    gap:14px;
  }

  .partner-logo{
    flex-basis:150px;
    width:150px;
  }
}

@media(max-width:700px){
  .partner-logos{
    gap:8px;
  }

  .partner-logo{
    flex-basis:125px;
    width:125px;
    height:52px;
  }

  .partner-divider{
    height:28px;
  }

  .logo-3dlab img{height:46px}
  .logo-veltrix img{height:43px}
  .logo-uthm img{height:48px}
  .logo-fkee img{height:44px}
  .logo-innocube img{height:41px}
}

@media(max-width:480px){
  .partners-panel{
    padding:18px 12px 20px;
  }

  .partner-logos{
    flex-wrap:wrap;
    row-gap:6px;
  }

  .partner-logo{
    flex-basis:120px;
    width:120px;
  }

  .partner-divider{
    display:none;
  }
}

/* Tasik FKEE icon — used in header and browser tab */
.brand-mark{
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
}
.brand-mark img{
  display:block;
  width:100%;
  height:100%;
  object-fit:contain;
}

/* =========================================================
   Theme system
   Dark = existing Tasik FKEE theme
   Light = soft off-white / warm neutral
   ========================================================= */
:root{
  --page-bg:#061426;
  --page-bg-2:#081b30;
  --surface:#0b2136;
  --surface-2:#0d263e;
  --surface-soft:rgba(11,33,54,.70);
  --border:rgba(151,194,225,.10);
  --border-strong:rgba(151,194,225,.16);
  --text:#f3f7fb;
  --text-soft:#8da8c1;
  --text-muted:#6685a2;
  --accent:#35a8ff;
  --grid:rgba(151,194,225,.055);
  --shadow:rgba(0,0,0,.18);
  --chart-text:#8da8c1;
}

html[data-theme="light"]{
  --page-bg:#f1f3f0;
  --page-bg-2:#e9eeeb;
  --surface:#f8faf8;
  --surface-2:#eef2ef;
  --surface-soft:rgba(248,250,248,.92);
  --border:rgba(35,55,70,.11);
  --border-strong:rgba(35,55,70,.17);
  --text:#17232d;
  --text-soft:#62727d;
  --text-muted:#71828d;
  --accent:#168bd2;
  --grid:rgba(35,55,70,.055);
  --shadow:rgba(28,42,50,.10);
  --chart-text:#647680;
}

/* Page */
html[data-theme="light"] body{
  background:
    radial-gradient(circle at 50% -15%, rgba(22,139,210,.055), transparent 36%),
    linear-gradient(180deg,var(--page-bg-2),var(--page-bg));
  color:var(--text);
}

html[data-theme="light"] body::before{
  opacity:.35;
}

html[data-theme="light"] .topbar{
  background:rgba(241,243,240,.92);
  border-bottom-color:var(--border);
  box-shadow:0 8px 30px rgba(30,45,55,.04);
}

html[data-theme="light"] .card,
html[data-theme="light"] .partners-panel,
html[data-theme="light"] .chart-card,
html[data-theme="light"] .stat-card,
html[data-theme="light"] .info-card{
  background:linear-gradient(145deg,var(--surface),var(--surface-2));
  border-color:var(--border);
  box-shadow:0 18px 45px var(--shadow);
}

html[data-theme="light"] .brand strong,
html[data-theme="light"] h1,
html[data-theme="light"] h2,
html[data-theme="light"] h3,
html[data-theme="light"] .value,
html[data-theme="light"] .footer-brand{
  color:var(--text);
}

html[data-theme="light"] .brand small,
html[data-theme="light"] .subtitle,
html[data-theme="light"] .muted,
html[data-theme="light"] .card-subtitle{
  color:var(--text-soft);
}

html[data-theme="light"] .partner-title span,
html[data-theme="light"] .eyebrow,
html[data-theme="light"] .section-label{
  color:#658096;
}

html[data-theme="light"] .partner-separator{
  background:linear-gradient(90deg,transparent,rgba(35,55,70,.13),transparent);
}

html[data-theme="light"] .partner-divider{
  background:rgba(35,55,70,.13);
}

html[data-theme="light"] .partner-logo{
  opacity:.68;
}

html[data-theme="light"] .theme-toggle{
  background:rgba(255,255,255,.70);
  border-color:var(--border-strong);
  color:#435560;
}

html[data-theme="light"] .theme-toggle:hover{
  background:#fff;
  border-color:rgba(22,139,210,.25);
}

html[data-theme="light"] .top-status{
  background:rgba(255,255,255,.58);
  border-color:var(--border);
}

html[data-theme="light"] select,
html[data-theme="light"] .range-select{
  background:#f8faf8;
  color:var(--text);
  border-color:var(--border-strong);
}

html[data-theme="light"] footer{
  color:#71828d;
}

html[data-theme="light"] .chart-card canvas{
  /* Keep Chart.js canvas transparent; JS controls grid/text colors. */
  filter:none;
}

/* Theme button */
.theme-toggle{
  appearance:none;
  border:1px solid rgba(151,194,225,.14);
  background:rgba(8,27,48,.72);
  color:#a9bfd2;
  min-height:34px;
  padding:0 11px;
  border-radius:10px;
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:7px;
  font:inherit;
  font-size:11px;
  font-weight:700;
  letter-spacing:.2px;
  cursor:pointer;
  transition:background .2s ease,border-color .2s ease,color .2s ease,transform .15s ease;
}

.theme-toggle:hover{
  background:rgba(13,38,62,.95);
  border-color:rgba(53,168,255,.28);
  color:#d7e7f4;
}

.theme-toggle:active{
  transform:translateY(1px);
}

.theme-icon{
  font-size:15px;
  line-height:1;
}

.theme-toggle-label{
  min-width:31px;
  text-align:left;
}

@media(max-width:700px){
  .theme-toggle{
    width:34px;
    min-width:34px;
    padding:0;
    gap:0;
  }
  .theme-toggle-label{
    display:none;
  }
}

/* Header actions: theme control immediately left of system status */
.header-actions{
  display:flex;
  align-items:center;
  justify-content:flex-end;
  gap:10px;
  margin-left:auto;
}

.header-actions .theme-toggle{
  flex:0 0 auto;
}

.header-actions .top-status{
  flex:0 0 auto;
}

@media(max-width:700px){
  .header-actions{
    gap:7px;
  }
}

